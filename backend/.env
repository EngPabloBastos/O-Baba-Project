# Copie este arquivo para ".env" e ajuste os valores

# Porta em que o servidor vai rodar
PORT=3000

# Chave secreta usada para gerar/validar os tokens de login (JWT)
# IMPORTANTE: troque isso por um valor aleatório e complexo antes de colocar em produção
JWT_SECRET=troque-esta-chave-por-uma-bem-dificil-de-adivinhar

# Quanto tempo o token de login fica válido
JWT_EXPIRES_IN=7d
